# AMO API credentials for `npm run sign`.
#
# Copy this file to `.env` (which is gitignored) and fill in both values from
# https://addons.mozilla.org/developers/addon/api/key/
#
# The secret is displayed exactly once and cannot be retrieved again. Anyone
# holding it can publish add-ons as you — treat it like a password, and revoke
# it on that page if it ever leaks.

AMO_JWT_ISSUER=user:12345678:123
AMO_JWT_SECRET=
